import "../fonts/Inter-Regular.otf";
import "../fonts/Inter-SemiBold.otf";

// ───────────────────────── Theme ─────────────────────────
export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg: dark ? #0b0e11 : #ffffff;
    out property <color> chat-bg: dark ? #0b0e11 : #f3f5f7;
    out property <color> surface: dark ? #14181d : #f2f4f6;
    out property <color> surface2: dark ? #1c2229 : #e7eaee;
    out property <color> line: dark ? #1d232a : #e8ebee;
    out property <color> text: dark ? #eceff2 : #0e1216;
    out property <color> sub: dark ? #8a949f : #6a7480;
    out property <color> accent: dark ? #34d8a4 : #0b8a63;
    out property <color> accent-solid: #2fd6a0;
    out property <color> accent-press: #25b98a;
    out property <color> on-accent: #04140e;
    out property <color> bubble-out: #0f7f63;
    out property <color> bubble-in: dark ? #1a2027 : #ffffff;
    out property <color> danger: #f0616d;
    out property <color> online: #34d8a4;
}

export struct ChatItem {
    id: string,
    uid: string,
    name: string,
    initials: string,
    tint: color,
    last: string,
    time: string,
    unread: int,
    online: bool,
    mine-last: bool,
    seen-last: bool,
    typing: bool,
}

export struct MsgItem {
    id: string,
    text: string,
    time: string,
    day: string,
    mine: bool,
    seen: bool,
    pending: bool,
    edited: bool,
    deleted: bool,
    last-in-group: bool,
}

export struct UserItem {
    uid: string,
    name: string,
    username: string,
    initials: string,
    tint: color,
    bio: string,
}

// ───────────────────────── Primitives ─────────────────────────
component Icon inherits Path {
    in property <string> d;
    in property <color> c: Theme.sub;
    in property <length> size: 24px;
    in property <bool> solid: false;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: d;
    stroke: solid ? transparent : c;
    fill: solid ? c : transparent;
    stroke-width: 1.8px * size / 24px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tint: #34d8a4;
    in property <bool> online: false;
    border-radius: self.width * 0.34;
    background: @linear-gradient(150deg, tint.darker(0.05) 0%, tint.darker(0.55) 100%);
    Text {
        text: root.initials;
        color: #ffffff;
        font-weight: 600;
        font-size: root.width * 0.36;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    Rectangle {
        width: root.online ? root.width * 0.28 : 0px;
        height: self.width;
        x: root.width - self.width * 0.85;
        y: root.height - self.height * 0.85;
        border-radius: self.width / 2;
        background: Theme.online;
        border-width: 2.5px;
        border-color: Theme.bg;
        animate width { duration: 200ms; easing: ease-out; }
    }
}

component Spinner inherits Rectangle {
    in property <bool> active: true;
    in property <color> c: Theme.on-accent;
    width: 22px;
    height: 22px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 3 A9 9 0 1 1 3 12";
        stroke: root.c;
        stroke-width: 2.4px;
        fill: transparent;
        stroke-line-cap: round;
        transform-rotation: root.active ? 360deg : 0deg;
        animate transform-rotation { duration: 800ms; iteration-count: -1; easing: linear; }
    }
}

component IconButton inherits Rectangle {
    in property <string> d;
    in property <color> c: Theme.text;
    in property <length> glyph: 22px;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: ta.pressed ? Theme.surface2 : transparent;
    animate background { duration: 120ms; }
    ta := TouchArea { clicked => { root.clicked(); } }
    Icon { d: root.d; c: root.c; size: root.glyph; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}

component Field inherits Rectangle {
    in property <string> label;
    in property <bool> password: false;
    in-out property <string> text <=> inp.text;
    callback accepted <=> inp.accepted;
    callback edited <=> inp.edited;
    property <bool> up: inp.has-focus || inp.text != "";
    height: 58px;
    border-radius: 16px;
    background: Theme.surface;
    border-width: 1.5px;
    border-color: inp.has-focus ? Theme.accent : Theme.line;
    animate border-color { duration: 160ms; }
    Text {
        text: root.label;
        x: 16px;
        y: root.up ? 9px : 19px;
        font-size: root.up ? 11px : 15px;
        color: inp.has-focus ? Theme.accent : Theme.sub;
        animate y, font-size { duration: 160ms; easing: ease-out; }
    }
    inp := TextInput {
        x: 16px;
        y: 26px;
        width: parent.width - 32px;
        height: 24px;
        font-size: 16px;
        color: Theme.text;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        selection-background-color: Theme.accent;
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> busy: false;
    callback clicked();
    height: 54px;
    border-radius: 16px;
    background: ta.pressed ? Theme.accent-press : Theme.accent-solid;
    animate background { duration: 120ms; }
    transform-scale: ta.pressed ? 0.98 : 1.0;
    animate transform-scale { duration: 100ms; }
    ta := TouchArea { enabled: !root.busy; clicked => { root.clicked(); } }
    if !root.busy: Text { text: root.label; color: Theme.on-accent; font-size: 16px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    if root.busy: Spinner { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}

component Logo inherits Rectangle {
    border-radius: self.width * 0.32;
    background: @linear-gradient(150deg, #3ff0b4 0%, #16a083 100%);
    Icon {
        d: "M12 20.5 V11 M12 14.5 L7 10 V6 M12 11.5 L17 7 V3.5";
        c: #04140e;
        size: root.width * 0.58;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component Title inherits Text {
    color: Theme.text;
    font-size: 28px;
    font-weight: 600;
}

// ───────────────────────── Chat list ─────────────────────────
component ChatRow inherits Rectangle {
    in property <ChatItem> c;
    callback clicked();
    height: 76px;
    property <float> appear: 0;
    init => { self.appear = 1; }
    animate appear { duration: 320ms; easing: ease-out; }
    opacity: appear;
    Rectangle {
        x: 8px;
        width: parent.width - 16px;
        border-radius: 18px;
        background: ta.pressed ? Theme.surface : transparent;
        animate background { duration: 120ms; }
        ta := TouchArea { clicked => { root.clicked(); } }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 10px;
            spacing: 13px;
            VerticalLayout {
                alignment: center;
                Avatar { width: 54px; height: 54px; initials: root.c.initials; tint: root.c.tint; online: root.c.online; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: root.c.name; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                    if root.c.mine-last: Icon {
                        d: root.c.seen-last ? "M2 12.5 L6.5 17 L15 7.5 M10.5 15.5 L12 17 L21 7.5" : "M5 12.5 L10 17.5 L19 7.5";
                        c: root.c.seen-last ? Theme.accent : Theme.sub;
                        size: 16px;
                        y: 3px;
                    }
                    Text { text: root.c.time; color: root.c.unread > 0 ? Theme.accent : Theme.sub; font-size: 12px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.c.typing ? "typing…" : root.c.last;
                        color: root.c.typing ? Theme.accent : Theme.sub;
                        font-size: 14.5px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.c.unread > 0: Rectangle {
                        property <float> pop: 0;
                        init => { self.pop = 1; }
                        animate pop { duration: 380ms; easing: cubic-bezier(0.3, 1.6, 0.5, 1); }
                        width: max(22px, badge-text.preferred-width + 14px);
                        height: 22px;
                        border-radius: 11px;
                        background: Theme.accent-solid;
                        transform-scale: pop;
                        badge-text := Text {
                            text: root.c.unread > 99 ? "99+" : root.c.unread;
                            color: Theme.on-accent;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }
        }
    }
}

component SkeletonRow inherits Rectangle {
    height: 76px;
    property <float> p: 0;
    init => { self.p = 1; }
    animate p { duration: 850ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px; spacing: 13px;
        VerticalLayout { alignment: center; Rectangle { width: 54px; height: 54px; border-radius: 18px; background: Theme.surface2; opacity: 0.4 + root.p * 0.6; } }
        VerticalLayout {
            alignment: center; spacing: 10px;
            Rectangle { width: 140px; height: 12px; border-radius: 6px; background: Theme.surface2; opacity: 0.4 + root.p * 0.6; }
            Rectangle { height: 11px; border-radius: 6px; background: Theme.surface; opacity: 0.4 + root.p * 0.6; }
        }
    }
}

// ───────────────────────── Messages ─────────────────────────
component MsgRow inherits Rectangle {
    in property <MsgItem> m;
    in property <length> maxw;
    callback tapped();
    property <float> appear: 0;
    init => { self.appear = 1; }
    animate appear { duration: 280ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
    height: lay.preferred-height;
    opacity: appear;
    lay := VerticalLayout {
        y: (1 - root.appear) * 16px;
        if root.m.day != "": Rectangle {
            height: 44px;
            HorizontalLayout {
                padding-left: 24px; padding-right: 24px; spacing: 12px;
                VerticalLayout { alignment: center; Rectangle { height: 1px; background: Theme.line; } }
                Text { text: root.m.day; color: Theme.sub; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                VerticalLayout { alignment: center; Rectangle { height: 1px; background: Theme.line; } }
            }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 1px;
            padding-bottom: root.m.last-in-group ? 6px : 1px;
            alignment: root.m.mine ? end : start;
            bubble := Rectangle {
                width: min(root.maxw, max(body.preferred-width, 66px) + 24px);
                height: col.preferred-height;
                background: root.m.mine ? Theme.bubble-out : Theme.bubble-in;
                border-width: (!root.m.mine && !Theme.dark) ? 1px : 0px;
                border-color: Theme.line;
                border-radius: 18px;
                border-bottom-right-radius: root.m.mine && root.m.last-in-group ? 6px : 18px;
                border-bottom-left-radius: !root.m.mine && root.m.last-in-group ? 6px : 18px;
                transform-scale: bta.pressed ? 0.985 : 1.0;
                animate transform-scale { duration: 100ms; }
                bta := TouchArea { clicked => { root.tapped(); } }
                col := VerticalLayout {
                    padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 6px; spacing: 1px;
                    body := Text {
                        text: root.m.deleted ? "Message deleted" : root.m.text;
                        wrap: word-wrap;
                        color: root.m.deleted ? Theme.sub : (root.m.mine ? #ffffff : Theme.text);
                        font-size: 15.5px;
                        font-italic: root.m.deleted;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 4px;
                        height: 15px;
                        if root.m.edited && !root.m.deleted: Text { text: "edited"; font-size: 11px; color: root.m.mine ? #ffffffa8 : Theme.sub; vertical-alignment: center; }
                        Text { text: root.m.time; font-size: 11px; color: root.m.mine ? #ffffffa8 : Theme.sub; vertical-alignment: center; }
                        if root.m.mine && !root.m.deleted: Rectangle {
                            width: 16px;
                            if root.m.pending: Icon { d: "M12 6.5 V12 L15.5 14"; c: #ffffffa8; size: 13px; x: 1.5px; y: 1px; }
                            if !root.m.pending: Icon {
                                d: root.m.seen ? "M2 12.5 L6.5 17 L15 7.5 M10.5 15.5 L12 17 L21 7.5" : "M5 12.5 L10 17.5 L19 7.5";
                                c: root.m.seen ? #c4f7e6 : #ffffffa8;
                                size: 16px;
                            }
                        }
                    }
                }
            }
        }
    }
}

component TypingBubble inherits Rectangle {
    in property <bool> active: false;
    property <int> tick: 0;
    height: active ? 36px : 0px;
    clip: true;
    animate height { duration: 180ms; easing: ease-out; }
    Timer { interval: 320ms; running: root.active; triggered => { root.tick = Math.mod(root.tick + 1, 3); } }
    Rectangle {
        x: 12px;
        width: 56px;
        height: 28px;
        border-radius: 14px;
        background: Theme.bubble-in;
        HorizontalLayout {
            alignment: center;
            spacing: 5px;
            for i in 3: Rectangle {
                width: 6px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.sub;
                    opacity: root.tick == i ? 1.0 : 0.35;
                    y: (parent.height - 6px) / 2 + (root.tick == i ? -3px : 0px);
                    animate opacity, y { duration: 200ms; }
                }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> d;
    in property <string> label;
    in property <bool> active: false;
    in property <int> badge: 0;
    callback clicked();
    TouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                transform-scale: root.active ? 1.08 : 1.0;
                animate transform-scale { duration: 200ms; easing: cubic-bezier(0.3, 1.5, 0.5, 1); }
                Icon { d: root.d; c: root.active ? Theme.accent : Theme.sub; size: 24px; }
                if root.badge > 0: Rectangle {
                    x: 14px; y: -4px;
                    width: max(16px, bt.preferred-width + 8px); height: 16px; border-radius: 8px;
                    background: Theme.accent-solid;
                    bt := Text { text: root.badge > 99 ? "99+" : root.badge; color: Theme.on-accent; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                }
            }
        }
        Text { text: root.label; color: root.active ? Theme.accent : Theme.sub; font-size: 11px; font-weight: root.active ? 600 : 400; horizontal-alignment: center; }
    }
}

// ───────────────────────── App window ─────────────────────────
export component AppWindow inherits Window {
    title: "RootChat";
    preferred-width: 420px;
    preferred-height: 860px;
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: 15px;

    in-out property <int> screen: 0; // 0 splash, 1 auth, 2 main
    in-out property <bool> signup-mode: false;
    in-out property <int> tab: 0;
    in-out property <bool> chat-open: false;
    in-out property <bool> sheet-open: false;
    in-out property <bool> dark <=> Theme.dark;

    in property <[ChatItem]> chats;
    in property <[MsgItem]> messages;
    in property <[UserItem]> results;
    in property <int> unread-total: 0;
    in property <bool> loading-chats: true;
    in property <bool> searching: false;
    in property <string> chat-title;
    in property <string> chat-status;
    in property <string> chat-initials;
    in property <color> chat-tint: #34d8a4;
    in property <bool> chat-online: false;
    in property <bool> peer-typing: false;
    in property <string> my-name;
    in property <string> my-username;
    in property <string> my-initials;
    in property <string> my-bio;
    in property <color> my-tint: #34d8a4;
    in property <bool> busy: false;
    in-out property <string> auth-error;
    in property <string> toast;
    in property <bool> online: true;

    in-out property <string> editing-id;
    in-out property <string> sheet-id;
    in-out property <string> sheet-text;
    out property <bool> at-bottom: flick.content-y >= flick.height - flick.content-height - 90px;

    callback login(string, string);
    callback signup(string, string, string, string);
    callback logout();
    callback open-chat(string);
    callback close-chat();
    callback send(string);
    callback edit-message(string, string);
    callback delete-message(string);
    callback typing();
    callback search(string);
    callback start-chat(string);
    callback save-profile(string, string);
    callback dark-changed(bool);
    callback search-opened();

    public function scroll-bottom() {
        flick.content-y = Math.min(0px, flick.height - flick.content-height);
    }
    function go-tab(t: int) {
        root.tab = t;
        if (t == 1) {
            root.search-opened();
            people-in.focus();
        }
    }

    property <length> chat-x: root.chat-open ? 0px : root.width;
    animate chat-x { duration: 300ms; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    property <length> sheet-y: root.sheet-open ? 0px : 200px;
    animate sheet-y { duration: 240ms; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }

    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (root.sheet-open) { root.sheet-open = false; return accept; }
                if (root.chat-open) { root.close-chat(); return accept; }
            }
            reject
        }
    }

    // ───────── Splash ─────────
    if root.screen == 0: Rectangle {
        background: Theme.bg;
        property <float> a: 0;
        init => { self.a = 1; }
        animate a { duration: 800ms; easing: cubic-bezier(0.3, 1.4, 0.5, 1); }
        Logo { width: 96px; height: 96px; x: (parent.width - self.width) / 2; y: parent.height * 0.38; transform-scale: parent.a; opacity: parent.a; }
        Text { text: "RootChat"; color: Theme.text; font-size: 26px; font-weight: 600; horizontal-alignment: center; x: 0px; width: parent.width; y: parent.height * 0.38 + 120px; opacity: parent.a; }
    }

    // ───────── Auth ─────────
    auth-bg := Rectangle {
        visible: root.screen == 1;
        background: Theme.bg;
        property <float> a: 0;
        init => { self.a = 1; }
        animate a { duration: 500ms; easing: ease-out; }
        Rectangle {
            height: 320px;
            background: @radial-gradient(circle, #34d8a42e 0%, #34d8a400 70%);
        }
        Flickable {
            content-height: max(self.height, authcol.preferred-height + 40px);
            authcol := VerticalLayout {
                alignment: center;
                padding-left: 24px; padding-right: 24px; padding-top: 28px; padding-bottom: 28px;
                spacing: 12px;
                y: (1 - auth-bg.a) * 24px;
                opacity: auth-bg.a;
                HorizontalLayout { alignment: start; Logo { width: 60px; height: 60px; } }
                Rectangle { height: 8px; }
                Text { text: root.signup-mode ? "Create your account" : "Welcome back"; color: Theme.text; font-size: 28px; font-weight: 600; }
                Text { text: root.signup-mode ? "Private messaging, in a few seconds." : "Sign in to continue to RootChat."; color: Theme.sub; font-size: 15px; }
                Rectangle { height: 10px; }
                Rectangle {
                    height: root.signup-mode ? 128px : 0px;
                    clip: true;
                    animate height { duration: 260ms; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
                    VerticalLayout {
                        spacing: 12px;
                        alignment: start;
                        name-f := Field { label: "Full name"; }
                        user-f := Field { label: "Username"; }
                    }
                }
                email-f := Field { label: "Email"; }
                pass-f := Field { label: "Password"; password: true; accepted => { submit.clicked(); } }
                Rectangle {
                    height: root.auth-error != "" ? 40px : 0px;
                    clip: true;
                    animate height { duration: 200ms; easing: ease-out; }
                    Rectangle {
                        background: #f0616d22;
                        border-radius: 12px;
                        Text { text: root.auth-error; color: Theme.danger; font-size: 13px; wrap: word-wrap; x: 14px; width: parent.width - 28px; vertical-alignment: center; height: 100%; }
                    }
                }
                submit := PrimaryButton {
                    label: root.signup-mode ? "Create account" : "Sign in";
                    busy: root.busy;
                    clicked => {
                        if (root.signup-mode) {
                            root.signup(name-f.text, user-f.text, email-f.text, pass-f.text);
                        } else {
                            root.login(email-f.text, pass-f.text);
                        }
                    }
                }
                Rectangle { height: 4px; }
                Rectangle {
                    height: 44px;
                    TouchArea { clicked => { root.signup-mode = !root.signup-mode; root.auth-error = ""; } }
                    Text {
                        text: root.signup-mode ? "Already have an account? Sign in" : "New here? Create an account";
                        color: Theme.accent; font-size: 14px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%;
                    }
                }
            }
        }
    }

    // ───────── Main ─────────
    Rectangle {
        visible: root.screen == 2;

        VerticalLayout {
            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg;
                clip: true;

                // ── Chats tab
                Rectangle {
                    opacity: root.tab == 0 ? 1.0 : 0.0;
                    x: root.tab == 0 ? 0px : -14px;
                    visible: self.opacity > 0.01;
                    animate opacity, x { duration: 200ms; easing: ease-out; }
                    VerticalLayout {
                        Rectangle {
                            height: 92px;
                            VerticalLayout {
                                padding-left: 22px; padding-right: 22px; padding-top: 18px; spacing: 2px;
                                Title { text: "Chats"; }
                                Text { text: root.online ? "End-to-end private · real-time" : "Connecting…"; color: root.online ? Theme.sub : Theme.accent; font-size: 13px; }
                            }
                        }
                        Rectangle {
                            height: 52px;
                            Rectangle {
                                x: 16px; y: 2px; width: parent.width - 32px; height: 44px;
                                border-radius: 16px;
                                background: sta.pressed ? Theme.surface2 : Theme.surface;
                                animate background { duration: 120ms; }
                                sta := TouchArea { clicked => { root.go-tab(1); } }
                                HorizontalLayout {
                                    padding-left: 14px; spacing: 10px;
                                    VerticalLayout { alignment: center; Icon { d: "M4 11 A7 7 0 0 1 18 11 A7 7 0 0 1 4 11 M16 16 L21 21"; c: Theme.sub; size: 18px; } }
                                    VerticalLayout { alignment: center; Text { text: "Search people"; color: Theme.sub; font-size: 15px; } }
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            clip: true;
                            if root.loading-chats && root.chats.length == 0: VerticalLayout {
                                for i in 7: SkeletonRow { }
                            }
                            if !root.loading-chats && root.chats.length == 0: VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                Rectangle {
                                    width: 84px; height: 84px; border-radius: 28px; background: Theme.surface; x: (parent.width - self.width) / 2;
                                    Icon { d: "M4 5.5 H20 V16.5 H9.5 L5 20.5 V16.5 H4 Z"; c: Theme.accent; size: 38px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                }
                                Text { text: "No conversations yet"; color: Theme.text; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "Find someone by username to start chatting"; color: Theme.sub; font-size: 14px; horizontal-alignment: center; }
                            }
                            Flickable {
                                content-height: rows.preferred-height + 16px;
                                rows := VerticalLayout {
                                    for c in root.chats: ChatRow { c: c; clicked => { root.open-chat(c.id); } }
                                }
                            }
                        }
                    }
                }

                // ── People tab
                Rectangle {
                    opacity: root.tab == 1 ? 1.0 : 0.0;
                    x: root.tab == 1 ? 0px : (root.tab < 1 ? 14px : -14px);
                    visible: self.opacity > 0.01;
                    animate opacity, x { duration: 200ms; easing: ease-out; }
                    VerticalLayout {
                        Rectangle {
                            height: 72px;
                            VerticalLayout { padding-left: 22px; padding-top: 18px; Title { text: "People"; } }
                        }
                        Rectangle {
                            height: 52px;
                            Rectangle {
                                x: 16px; y: 2px; width: parent.width - 32px; height: 44px;
                                border-radius: 16px;
                                background: Theme.surface;
                                border-width: 1.5px;
                                border-color: people-in.has-focus ? Theme.accent : Theme.line;
                                animate border-color { duration: 160ms; }
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 12px; spacing: 10px;
                                    VerticalLayout { alignment: center; Icon { d: "M4 11 A7 7 0 0 1 18 11 A7 7 0 0 1 4 11 M16 16 L21 21"; c: Theme.sub; size: 18px; } }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        if people-in.text == "": Text { text: "Search by username"; color: Theme.sub; font-size: 15px; vertical-alignment: center; x: 0px; height: 100%; }
                                        people-in := TextInput {
                                            height: 100%;
                                            font-size: 16px; color: Theme.text; single-line: true;
                                            vertical-alignment: center;
                                            selection-background-color: Theme.accent;
                                            edited => { root.search(self.text); }
                                        }
                                    }
                                    if root.searching: VerticalLayout { alignment: center; Spinner { c: Theme.accent; width: 18px; height: 18px; } }
                                    if !root.searching && people-in.text != "": IconButton {
                                        d: "M7 7 L17 17 M17 7 L7 17"; c: Theme.sub; glyph: 16px; width: 32px; height: 32px;
                                        clicked => { people-in.text = ""; root.search(""); }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            clip: true;
                            if root.results.length == 0: VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                Rectangle {
                                    width: 84px; height: 84px; border-radius: 28px; background: Theme.surface; x: (parent.width - self.width) / 2;
                                    Icon { d: "M9 11 A3.5 3.5 0 1 0 9 4 A3.5 3.5 0 1 0 9 11 M2.5 20.5 A6.5 6.5 0 0 1 15.5 20.5 M16 4.5 A3.5 3.5 0 0 1 16 11 M18.5 14.5 A6.5 6.5 0 0 1 21.5 20.5"; c: Theme.accent; size: 38px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                }
                                Text { text: people-in.text == "" ? "Find people" : (root.searching ? "Searching…" : "No users found"); color: Theme.text; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "Type a username to start a conversation"; color: Theme.sub; font-size: 14px; horizontal-alignment: center; }
                            }
                            Flickable {
                                content-height: rcol.preferred-height + 16px;
                                rcol := VerticalLayout {
                                    for u in root.results: Rectangle {
                                        height: 72px;
                                        property <float> appear: 0;
                                        init => { self.appear = 1; }
                                        animate appear { duration: 260ms; easing: ease-out; }
                                        opacity: appear;
                                        Rectangle {
                                            x: 8px; width: parent.width - 16px;
                                            border-radius: 18px;
                                            background: uta.pressed ? Theme.surface : transparent;
                                            animate background { duration: 120ms; }
                                            uta := TouchArea { clicked => { root.start-chat(u.uid); people-in.text = ""; root.search(""); } }
                                            HorizontalLayout {
                                                padding-left: 8px; spacing: 13px;
                                                VerticalLayout { alignment: center; Avatar { width: 50px; height: 50px; initials: u.initials; tint: u.tint; } }
                                                VerticalLayout {
                                                    alignment: center; spacing: 3px;
                                                    Text { text: u.name; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                                                    Text { text: "@" + u.username + (u.bio != "" ? "  ·  " + u.bio : ""); color: Theme.sub; font-size: 14px; overflow: elide; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Me tab
                Rectangle {
                    opacity: root.tab == 2 ? 1.0 : 0.0;
                    x: root.tab == 2 ? 0px : 14px;
                    visible: self.opacity > 0.01;
                    animate opacity, x { duration: 200ms; easing: ease-out; }
                    Flickable {
                        content-height: pcol.preferred-height + 24px;
                        pcol := VerticalLayout {
                            padding-left: 20px; padding-right: 20px; padding-top: 18px; spacing: 12px;
                            Title { text: "Profile"; }
                            Rectangle { height: 8px; }
                            HorizontalLayout {
                                spacing: 16px;
                                Avatar { width: 80px; height: 80px; initials: root.my-initials; tint: root.my-tint; }
                                VerticalLayout {
                                    alignment: center; spacing: 3px;
                                    Text { text: root.my-name; color: Theme.text; font-size: 20px; font-weight: 600; overflow: elide; }
                                    Text { text: "@" + root.my-username; color: Theme.sub; font-size: 14px; }
                                }
                            }
                            Rectangle { height: 6px; }
                            pn := Field { label: "Display name"; text: root.my-name; }
                            pb := Field { label: "Bio"; text: root.my-bio; }
                            PrimaryButton { label: "Save changes"; clicked => { root.save-profile(pn.text, pb.text); } }
                            Rectangle { height: 8px; }
                            Rectangle {
                                height: 58px;
                                border-radius: 16px;
                                background: Theme.surface;
                                TouchArea { clicked => { root.dark = !root.dark; root.dark-changed(root.dark); } }
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 14px;
                                    VerticalLayout { alignment: center; Icon { d: root.dark ? "M20 14.5 A8 8 0 1 1 9.5 4 A6.5 6.5 0 0 0 20 14.5 Z" : "M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 M12 2.5 V4.5 M12 19.5 V21.5 M2.5 12 H4.5 M19.5 12 H21.5 M5.3 5.3 L6.7 6.7 M17.3 17.3 L18.7 18.7 M5.3 18.7 L6.7 17.3 M17.3 6.7 L18.7 5.3"; c: Theme.accent; size: 22px; } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 1; Text { text: root.dark ? "Dark theme" : "Light theme"; color: Theme.text; font-size: 16px; } }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 46px; height: 28px; border-radius: 14px;
                                            background: root.dark ? Theme.accent-solid : Theme.surface2;
                                            animate background { duration: 200ms; }
                                            Rectangle {
                                                width: 22px; height: 22px; border-radius: 11px; background: root.dark ? Theme.on-accent : #ffffff;
                                                y: 3px;
                                                x: root.dark ? 21px : 3px;
                                                animate x { duration: 200ms; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 58px;
                                border-radius: 16px;
                                background: lta.pressed ? Theme.surface2 : Theme.surface;
                                animate background { duration: 120ms; }
                                lta := TouchArea { clicked => { root.logout(); } }
                                HorizontalLayout {
                                    padding-left: 16px; spacing: 14px;
                                    VerticalLayout { alignment: center; Icon { d: "M9 4 H5 V20 H9 M15 8 L20 12 L15 16 M20 12 H9"; c: Theme.danger; size: 22px; } }
                                    VerticalLayout { alignment: center; Text { text: "Sign out"; color: Theme.danger; font-size: 16px; } }
                                }
                            }
                            Text { text: "RootChat 2.0 · built with Rust"; color: Theme.sub; font-size: 12px; horizontal-alignment: center; }
                        }
                    }
                }
            }

            // ── tab bar
            Rectangle {
                height: 64px;
                background: Theme.bg;
                Rectangle { height: 1px; background: Theme.line; }
                Rectangle {
                    y: 0px;
                    height: 2px;
                    width: 28px;
                    x: parent.width / 6 * (1 + 2 * root.tab) - 14px;
                    border-radius: 1px;
                    background: Theme.accent;
                    animate x { duration: 280ms; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
                }
                HorizontalLayout {
                    TabButton { d: "M4 5.5 H20 V16.5 H9.5 L5 20.5 V16.5 H4 Z"; label: "Chats"; active: root.tab == 0; badge: root.unread-total; clicked => { root.go-tab(0); } }
                    TabButton { d: "M9 11 A3.5 3.5 0 1 0 9 4 A3.5 3.5 0 1 0 9 11 M2.5 20.5 A6.5 6.5 0 0 1 15.5 20.5 M16 4.5 A3.5 3.5 0 0 1 16 11 M18.5 14.5 A6.5 6.5 0 0 1 21.5 20.5"; label: "People"; active: root.tab == 1; clicked => { root.go-tab(1); } }
                    TabButton { d: "M12 11 A4 4 0 1 0 12 3 A4 4 0 1 0 12 11 M4 21 A8 8 0 0 1 20 21"; label: "Profile"; active: root.tab == 2; clicked => { root.go-tab(2); } }
                }
            }
        }

        // ── chat page (slides over)
        Rectangle {
            x: root.chat-x;
            background: Theme.chat-bg;
            visible: root.chat-x < root.width;
            VerticalLayout {
                Rectangle {
                    height: 62px;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 8px; spacing: 8px;
                        VerticalLayout { alignment: center; IconButton { d: "M15 5 L8 12 L15 19"; clicked => { root.close-chat(); } } }
                        VerticalLayout { alignment: center; Avatar { width: 42px; height: 42px; initials: root.chat-initials; tint: root.chat-tint; online: root.chat-online; } }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text { text: root.chat-title; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                            Text {
                                text: root.peer-typing ? "typing…" : root.chat-status;
                                color: (root.peer-typing || root.chat-online) ? Theme.accent : Theme.sub;
                                font-size: 12.5px;
                                overflow: elide;
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    flick := Flickable {
                        content-height: max(self.height, mcol.preferred-height + 8px);
                        mcol := VerticalLayout {
                            height: flick.content-height;
                            alignment: end;
                            padding-top: 8px;
                            padding-bottom: 6px;
                            for m in root.messages: MsgRow {
                                m: m;
                                maxw: root.width * 0.8;
                                tapped => {
                                    if (m.mine && !m.deleted && !m.pending) {
                                        root.sheet-id = m.id;
                                        root.sheet-text = m.text;
                                        root.sheet-open = true;
                                    }
                                }
                            }
                            TypingBubble { active: root.peer-typing; }
                        }
                    }
                    Rectangle {
                        width: 42px; height: 42px; border-radius: 14px;
                        x: parent.width - 42px - 14px;
                        y: parent.height - 42px - 12px + (root.at-bottom ? 70px : 0px);
                        animate y { duration: 220ms; easing: ease-out; }
                        background: Theme.surface2;
                        TouchArea { clicked => { root.scroll-bottom(); } }
                        Icon { d: "M6 9.5 L12 15.5 L18 9.5"; c: Theme.text; size: 20px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    }
                }
                // composer
                Rectangle {
                    background: Theme.bg;
                    height: cbox.preferred-height;
                    Rectangle { height: 1px; background: Theme.line; }
                    cbox := VerticalLayout {
                        if root.editing-id != "": Rectangle {
                            height: 40px;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 6px; spacing: 10px;
                                VerticalLayout { alignment: center; Icon { d: "M4 20 V16 L16 4 L20 8 L8 20 Z"; c: Theme.accent; size: 18px; } }
                                VerticalLayout { alignment: center; horizontal-stretch: 1; Text { text: "Editing message"; color: Theme.accent; font-weight: 600; font-size: 13px; } }
                                VerticalLayout { alignment: center; IconButton { d: "M7 7 L17 17 M17 7 L7 17"; glyph: 16px; clicked => { root.editing-id = ""; comp.text = ""; } } }
                            }
                        }
                        HorizontalLayout {
                            padding: 10px; spacing: 10px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: max(46px, min(130px, comp.preferred-height + 22px));
                                border-radius: 23px;
                                background: Theme.surface;
                                animate height { duration: 120ms; }
                                if comp.text == "": Text { text: "Message"; color: Theme.sub; font-size: 16px; x: 18px; y: (parent.height - self.height) / 2; }
                                comp := TextInput {
                                    x: 18px; y: 11px;
                                    width: parent.width - 36px;
                                    height: parent.height - 22px;
                                    font-size: 16px;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                    single-line: false;
                                    selection-background-color: Theme.accent;
                                    edited => { root.typing(); }
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                Rectangle {
                                    width: 46px; height: 46px; border-radius: 23px;
                                    property <bool> ready: comp.text != "";
                                    background: ready ? Theme.accent-solid : Theme.surface;
                                    animate background { duration: 180ms; }
                                    transform-scale: sta2.pressed ? 0.9 : 1.0;
                                    animate transform-scale { duration: 100ms; }
                                    sta2 := TouchArea {
                                        enabled: parent.ready;
                                        clicked => {
                                            if (root.editing-id != "") {
                                                root.edit-message(root.editing-id, comp.text);
                                                root.editing-id = "";
                                            } else {
                                                root.send(comp.text);
                                            }
                                            comp.text = "";
                                        }
                                    }
                                    Icon {
                                        d: root.editing-id != "" ? "M5 12.5 L10 17.5 L19 7.5" : "M21 3 L10 14 M21 3 L14.5 21 L10 14 L3 9.5 Z";
                                        c: parent.ready ? Theme.on-accent : Theme.sub;
                                        size: 22px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── message action sheet
        Rectangle {
            visible: root.sheet-open || root.sheet-y < 200px;
            Rectangle {
                background: #000000;
                opacity: root.sheet-open ? 0.5 : 0.0;
                animate opacity { duration: 220ms; }
                TouchArea { clicked => { root.sheet-open = false; } }
            }
            Rectangle {
                y: parent.height - 190px + root.sheet-y;
                height: 190px;
                background: Theme.dark ? #14181d : #ffffff;
                border-top-left-radius: 24px;
                border-top-right-radius: 24px;
                VerticalLayout {
                    padding-top: 10px;
                    Rectangle { height: 16px; Rectangle { width: 36px; height: 4px; border-radius: 2px; background: Theme.sub; opacity: 0.4; } }
                    Rectangle {
                        height: 58px;
                        background: eta.pressed ? Theme.surface : transparent;
                        eta := TouchArea {
                            clicked => {
                                root.editing-id = root.sheet-id;
                                comp.text = root.sheet-text;
                                comp.focus();
                                root.sheet-open = false;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 24px; spacing: 18px;
                            VerticalLayout { alignment: center; Icon { d: "M4 20 V16 L16 4 L20 8 L8 20 Z"; c: Theme.text; size: 22px; } }
                            VerticalLayout { alignment: center; Text { text: "Edit message"; color: Theme.text; font-size: 16px; } }
                        }
                    }
                    Rectangle {
                        height: 58px;
                        background: dta2.pressed ? Theme.surface : transparent;
                        dta2 := TouchArea { clicked => { root.delete-message(root.sheet-id); root.sheet-open = false; } }
                        HorizontalLayout {
                            padding-left: 24px; spacing: 18px;
                            VerticalLayout { alignment: center; Icon { d: "M5 7 H19 M9.5 7 V4.5 H14.5 V7 M7 7 L8 20 H16 L17 7"; c: Theme.danger; size: 22px; } }
                            VerticalLayout { alignment: center; Text { text: "Delete message"; color: Theme.danger; font-size: 16px; } }
                        }
                    }
                }
            }
        }
    }

    // ───────── Toast ─────────
    Rectangle {
        width: min(root.width - 40px, toast-text.preferred-width + 40px);
        height: 44px;
        x: (root.width - self.width) / 2;
        y: root.toast != "" ? 48px : -60px;
        animate y { duration: 280ms; easing: cubic-bezier(0.3, 1.4, 0.5, 1); }
        border-radius: 22px;
        background: Theme.dark ? #232b33 : #0e1216;
        visible: self.y > -59px;
        toast-text := Text { text: root.toast; color: #ffffff; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; overflow: elide; }
    }
}
